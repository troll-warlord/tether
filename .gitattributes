# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files that should always use LF
*.js        text eol=lf
*.mjs       text eol=lf
*.vue       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf

# Declare binary files to prevent corruption
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
